{
  "name": "mediagrab",
  "version": "1.7.0",
  "description": "Cross-platform video downloader with browser UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npx vite --host",
    "build": "cd client && npx vite build",
    "start": "NODE_ENV=production node server/index.js",
    "install:deps": "npm install && cd client && npm install",
    "test": "node --test tests/*.test.js",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run build && npm test",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "playwright": "^1.60.0",
    "@xmldom/xmldom": "^0.8.11"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
